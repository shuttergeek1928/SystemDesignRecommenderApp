#### B. Batch Baseline Generator Script
**File (new):** `tools/generate_baselines.py`

```python
"""
Batch script to generate Baseline B (RAG-only) and Baseline C (Hybrid)
for all 40 scenarios in the reference dataset.
Reads from data/architecture_dataset_40.json,
calls the RAG engine and Core API, and writes back enriched blueprints.
"""
import json
import requests

DATASET_PATH = "../data/architecture_dataset_40.json"
RAG_URL = "http://localhost:8001/generate/rag"
HYBRID_URL = "http://localhost:5220/api/SystemDesign/generate"

def generate_baselines():
    with open(DATASET_PATH) as f:
        scenarios = json.load(f)
    
    for scenario in scenarios:
        if "baseline_B_automated" not in scenario.get("ground_truth_architecture", {}):
            # Call RAG-only endpoint
            rag_result = requests.post(RAG_URL, json={
                "requirements": {
                    "scenario_id": scenario["scenario_id"],
                    "title": scenario["title"],
                    "description": scenario["description"],
                    "context": scenario["context"],
                    "non_functional_requirements": scenario["non_functional_requirements"]
                },
                "node_structure": {k: {"choice": "", "justification": ""} 
                                   for k in ["database", "cache", "messaging", "deployment", "observability", "security"]}
            })
            if rag_result.ok:
                scenario["ground_truth_architecture"]["baseline_B_automated"] = rag_result.json()
    
    with open(DATASET_PATH, "w") as f:
        json.dump(scenarios, f, indent=2)

if __name__ == "__main__":
    generate_baselines()
```

